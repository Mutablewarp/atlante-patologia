---
import AboutPage from '../../../components/AboutPage.astro';
import Bi from '../../../components/Bi.astro';
import { langPaths, type Lang } from '../../../i18n/index.ts';
import { images } from '../../../lib/content.ts';
import { structureById } from '../../../lib/pathways.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const imgs = (await images()).sort((a, b) => a.id.localeCompare(b.id));
const OFL = 'https://openfontlicense.org';
const structs = [...(await structureById()).values()].sort((a, b) => a.pdb.localeCompare(b.pdb));
---

<AboutPage lang={lang} slug="credits">
  <h2>{lang === 'it' ? 'Immagini' : 'Images'}</h2>
  {
    imgs.length === 0 ? (
      <Bi lang={lang}>
        <p slot="it" class="empty-state">
          Non ci sono ancora immagini pubblicate. Ogni immagine avrà qui autore, fonte, licenza ed eventuali modifiche.
        </p>
        <p slot="en" class="empty-state">
          No images are published yet. Each image will be listed here with its author, source, licence and any changes we
          made.
        </p>
      </Bi>
    ) : (
      <ul>
        {imgs.map((img) => (
          <li id={`img-${img.id}`}>
            {img.attributionText} — <a href={img.sourceUrl} rel="noopener">{lang === 'it' ? 'fonte' : 'source'}</a>,{' '}
            <a href={img.licenseUrl} rel="noopener">{img.license}</a>
            {img.modifications !== 'none' && ` · ${lang === 'it' ? 'modifiche' : 'changes'}: ${img.modifications}`}
          </li>
        ))}
      </ul>
    )
  }

  {
    structs.length > 0 && (
      <>
        <h2 id="structures">{lang === 'it' ? 'Strutture 3D' : '3D structures'}</h2>
        <Bi lang={lang}>
          <p slot="it">
            Dati del Protein Data Bank (RCSB PDB), di pubblico dominio (CC0 1.0); ringraziamo gli autori di ogni struttura.
            Le immagini statiche e la vista 3D sono rese con 3Dmol.js.
          </p>
          <p slot="en">
            Data from the Protein Data Bank (RCSB PDB), in the public domain (CC0 1.0); we credit the authors of each structure.
            The still images and the 3D view are drawn with 3Dmol.js.
          </p>
        </Bi>
        <ul>
          {structs.map((s) => (
            <li id={`pdb-${s.id}`}>
              <a href={s.sourceUrl} rel="noopener">PDB {s.pdb}</a> — <span lang="en">{s.title}</span>.{' '}
              <span lang="en">{s.citation.authors.split('; ')[0]} et al., {s.citation.journal} ({s.citation.year})</span>
              {s.citation.doi && (
                <>
                  {' '}· <a href={`https://doi.org/${s.citation.doi}`} rel="noopener">doi:{s.citation.doi}</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>{lang === 'it' ? 'Caratteri tipografici' : 'Typefaces'}</h2>
  <ul>
    <li>
      <strong>Fraunces</strong> — © 2020 The Fraunces Project Authors (Undercase Type).{' '}
      <a href={OFL} rel="noopener">SIL Open Font License 1.1</a>.
    </li>
    <li>
      <strong>Atkinson Hyperlegible Next</strong> — © 2020–2024 The Atkinson Hyperlegible Next Project Authors.{' '}
      <a href={OFL} rel="noopener">SIL Open Font License 1.1</a>.
    </li>
  </ul>
  <Bi lang={lang}>
    <p slot="it">I caratteri sono inclusi nel sito tramite i pacchetti Fontsource, senza richieste a servizi esterni.</p>
    <p slot="en">The fonts are bundled with the site through the Fontsource packages, with no requests to external services.</p>
  </Bi>

  <h2>{lang === 'it' ? 'Software' : 'Software'}</h2>
  <Bi lang={lang}>
    <p slot="it">
      Il sito è costruito con Astro, Preact e Pagefind; il ripasso a intervalli userà ts-fsrs. Tutti sono software libero con
      licenze permissive.
    </p>
    <p slot="en">The site is built with Astro, Preact and Pagefind; spaced review will use ts-fsrs. All are free software under permissive licences.</p>
  </Bi>
</AboutPage>
