---
/** A–Z of entities and glossary terms (all names, both languages); `#term-<id>` anchors. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/nav/Breadcrumb.astro';
import { langPaths, type Lang } from '../../../i18n/index.ts';
import { tCommon } from '../../../i18n/common.ts';
import { tAtlas } from '../../../i18n/pages.ts';
import { langPath } from '../../../lib/url.ts';
import { siteData, glossary } from '../../../lib/content.ts';
import { glossaryAnchor } from '../../../lib/horizontal.ts';
import { tHz } from '../../../i18n/horizontal.ts';
import '../../../styles/horizontal.css';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = (k: Parameters<typeof tAtlas>[1]) => tAtlas(lang, k);
const { entities, entityById } = await siteData();
const other = lang === 'it' ? 'en' : 'it';
const collator = new Intl.Collator(lang, { sensitivity: 'base' });
type Row = { name: string; href: string; anchor?: string; primary?: string; definition?: string };
const entityRows: Row[] = entities.flatMap((e) =>
  [e.names[lang], e.names[other], ...e.names.synonyms[lang], ...e.names.eponyms].map((name, i) => ({
    name,
    href: langPath(lang, `e/${e.id}/`),
    anchor: i === 0 ? `term-${e.id}` : undefined,
    primary: i === 0 ? undefined : e.names[lang],
  })),
);
const glossaryRows: Row[] = (await glossary()).flatMap((g) => {
  const anchor = glossaryAnchor(g.id, entityById);
  return [
    { name: g.term[lang], href: `#${anchor}`, anchor, definition: g.definition[lang] },
    ...[g.term[other], ...g.aliases[lang]].map((name) => ({ name, href: `#${anchor}`, primary: g.term[lang] })),
  ];
});
const rows = [...entityRows, ...glossaryRows].sort((a, b) => collator.compare(a.name, b.name));
const letterOf = (s: string) => s.normalize('NFD').charAt(0).toUpperCase();
const letters = [...new Set(rows.map((r) => letterOf(r.name)))];
---

<BaseLayout lang={lang} title={t('azTitle')} description={t('azBody')} tab="atlas">
  <Breadcrumb lang={lang} items={[{ label: t('title'), href: langPath(lang, 'atlas/') }, { label: t('az') }]} />
  <header class="page-head">
    <h1>{t('azTitle')}</h1>
    <p class="lede">{t('azBody')}</p>
  </header>
  {
    rows.length === 0 ? (
      <div class="empty-state">
        <p style="margin:0">
          {t('emptyAz')} <a href={langPath(lang, 'about/roadmap/')}>{tCommon(lang, 'roadmap')}</a>
        </p>
      </div>
    ) : (
      letters.map((letter) => (
        <section aria-labelledby={`letter-${letter}`}>
          <h2 id={`letter-${letter}`}>{letter}</h2>
          <ul class="term-list">
            {rows
              .filter((r) => letterOf(r.name) === letter)
              .map((r) => (
                <li id={r.anchor}>
                  {r.definition ? (
                    <span class="az-gloss">
                      <dfn>{r.name}</dfn> <span class="badge">{tHz(lang, 'glossary')}</span>
                      <span class="small muted">{r.definition}</span>
                    </span>
                  ) : (
                    <a href={r.href}>{r.name}</a>
                  )}
                  {r.primary && <span class="small muted">→ {r.primary}</span>}
                </li>
              ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
