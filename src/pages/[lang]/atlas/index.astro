---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langPaths, type Lang } from '../../../i18n/index.ts';
import { tCommon } from '../../../i18n/common.ts';
import { tAtlas } from '../../../i18n/pages.ts';
import { LENSES } from '../../../lib/schema.ts';
import { langPath } from '../../../lib/url.ts';
import { siteData, patterns } from '../../../lib/content.ts';
import { tHz } from '../../../i18n/horizontal.ts';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = (k: Parameters<typeof tAtlas>[1]) => tAtlas(lang, k);
const { taxonomy, membership, modules } = await siteData(lang);
const lenses = LENSES.map((lens) => {
  const tax = taxonomy.get(lens);
  const counts = membership.get(lens)!;
  const used = [...counts.values()].reduce((n, ids) => n + ids.length, 0);
  // Terms with a page (D036) are linked inline: Home → Atlas → term → entity (NAVIGATION_SPEC ≤ 3 taps).
  const linked = (tax?.terms ?? []).filter((x) => (counts.get(x.id)?.length ?? 0) > 0);
  return { lens, label: tax?.label[lang] ?? lens, terms: tax?.terms ?? [], linked, used };
});
const pats = await patterns();
const tools = (['compare', 'diff', 'map', 'paths'] as const).map((k) => ({
  href: langPath(lang, { compare: 'compare/', diff: 'differential/', map: 'map/', paths: 'paths/' }[k]),
  title: tHz(lang, `${k}Title`),
  body: tHz(lang, `${k}Body`),
}));
const sections = (['I', 'II', 'III'] as const).map((s) => ({
  id: s,
  label: tCommon(lang, `section${s}`),
  modules: modules.filter((m) => m.section === s),
}));
---

<BaseLayout lang={lang} title={t('title')} description={t('metaDescription')} tab="atlas">
  <header class="page-head">
    <h1>{t('title')}</h1>
    <p class="lede">{t('intro')}</p>
  </header>

  <section aria-labelledby="lenses-title">
    <h2 id="lenses-title">{t('lenses')}</h2>
    <ul class="grid lens-grid">
      {
        lenses.map((l) => (
          <li>
            <div class="card lens-card">
              <h3>
                <a href={langPath(lang, `atlas/${l.lens}/`)}>{l.label} →</a>
              </h3>
              {l.linked.length > 0 ? (
                <ul class="lens-terms small">
                  {l.linked.map((x) => (
                    <li>
                      <a href={langPath(lang, `atlas/${l.lens}/${x.id}/`)}>{x.label[lang]}</a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="small muted">
                  {l.terms
                    .slice(0, 6)
                    .map((x) => x.label[lang])
                    .join(' · ')}
                  {l.terms.length > 6 && ' …'}
                </p>
              )}
            </div>
          </li>
        ))
      }
      <li>
        <a class="card link-card" href={langPath(lang, 'atlas/az/')}>
          <h3>{t('azTitle')} →</h3>
          <p class="small muted">{t('azBody')}</p>
        </a>
      </li>
    </ul>
  </section>

  <section aria-labelledby="tools-title">
    <h2 id="tools-title">{tHz(lang, 'toolsTitle')}</h2>
    <ul class="grid lens-grid">
      {
        tools.map((x) => (
          <li>
            <a class="card link-card" href={x.href}>
              <h3>{x.title} →</h3>
              <p class="small muted">{x.body}</p>
            </a>
          </li>
        ))
      }
    </ul>
    {
      pats.length > 0 && (
        <>
          <h3>{tHz(lang, 'patternsTitle')}</h3>
          <p class="muted">{tHz(lang, 'patternsBody')}</p>
          <ul class="term-list pattern-list">
            {pats.map((p) => (
              <li>
                <a href={langPath(lang, `pattern/${p.id}/`)}>{p.names[lang]}</a>
                <span class="small muted">{p.summary[lang]}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <section aria-labelledby="modules-title">
    <h2 id="modules-title">{t('modules')}</h2>
    <p class="muted" style="max-width:var(--measure)">{t('modulesIntro')}</p>
    {
      sections.map((s) => (
        <>
          <h3>{s.label}</h3>
          <ul class="module-list">
            {s.modules.map((m) => (
              <li>
                <a href={m.status === 'published' ? langPath(lang, `atlas/system/`) : langPath(lang, `about/roadmap/#${m.id}`)}>
                  <span class="module-id">{m.id.toUpperCase()}</span>
                  <span>{m.label[lang]}</span>
                  <span class={`badge ${m.status === 'published' ? 'badge-published' : 'badge-planned'}`}>
                    {tCommon(lang, m.status)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </section>
</BaseLayout>
