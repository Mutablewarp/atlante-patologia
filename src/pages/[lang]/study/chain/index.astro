---
import StudyPage from '../../../../components/study/StudyPage.astro';
import Chain, { type ChainLink } from '../../../../islands/Chain.tsx';
import { langPaths, type Lang } from '../../../../i18n/index.ts';
import { tS } from '../../../../i18n/study.ts';
import { tNav } from '../../../../i18n/nav.ts';
import { langPath } from '../../../../lib/url.ts';
import { siteData } from '../../../../lib/content.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const { entities } = await siteData(lang);
const links: ChainLink[] = entities.flatMap((e) =>
  e.chain.map((c) => ({ entity: e.id, name: e.names[lang], pathology: c.pathology[lang], sign: c.sign[lang], lab: c.lab[lang] })),
);
---

<StudyPage lang={lang} tab="study" title={tS(lang, 'chainTitle')} intro={tS(lang, 'chainIntro')} parent={{ label: tNav(lang, 'study'), href: langPath(lang, 'study/') }}>
  <Chain client:load lang={lang} links={links} />
</StudyPage>
