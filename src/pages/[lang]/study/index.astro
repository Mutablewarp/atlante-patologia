---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langPaths, type Lang } from '../../../i18n/index.ts';
import { tStudy } from '../../../i18n/pages.ts';
import { tS } from '../../../i18n/study.ts';
import { langPath } from '../../../lib/url.ts';
import { pathways } from '../../../lib/pathways.ts';
import '../../../styles/study.css';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = (k: Parameters<typeof tStudy>[1]) => tStudy(lang, k);
const modes: [string, string, string][] = [
  ...(
    [
      ['reviewTitle', 'reviewBody', 'study/review/'],
      ['quizTitle', 'quizBody', 'study/quiz/'],
      ['imagesTitle', 'imagesBody', 'study/images/'],
      ['chainTitle', 'chainBody', 'study/chain/'],
      ['plannerTitle', 'plannerBody', 'study/planner/'],
      ['lastWeekTitle', 'lastWeekBody', 'study/review/?cram=1'],
    ] as const
  ).map(([title, body, path]): [string, string, string] => [t(title), t(body), path]),
  [tS(lang, 'oralTitle'), tS(lang, 'oralIntro'), 'study/oral/'],
];
const pws = await pathways();
---

<BaseLayout lang={lang} title={t('title')} description={t('metaDescription')} tab="study">
  <header class="page-head">
    <h1>{t('title')}</h1>
    <p class="lede">{tS(lang, 'hubIntro')}</p>
  </header>
  <ap-export-reminder></ap-export-reminder>
  <div class="hub-status">
    <p class="hub-due"><ap-due-count></ap-due-count></p>
    <ap-resume></ap-resume>
  </div>
  <ul class="grid">
    {
      modes.map(([title, body, path]) => (
        <li>
          <a class="card link-card mode-card" href={langPath(lang, path)}>
            <h2>{title} →</h2>
            <p class="muted">{body}</p>
          </a>
        </li>
      ))
    }
    {/* v2/3d-pathways: molecular pathways with the 3D viewer */}
    {
      pws.map((p) => (
        <li>
          <a class="card link-card mode-card" href={langPath(lang, `pathways/${p.id}/`)}>
            <h2>{p.title[lang]} →</h2>
            <p class="muted">{p.summary[lang]}</p>
          </a>
        </li>
      ))
    }
  </ul>
  <p><a href={langPath(lang, 'about/evidence/')}>{tS(lang, 'evidenceLink')} →</a></p>
</BaseLayout>
