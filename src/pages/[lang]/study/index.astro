---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langPaths, type Lang } from '../../../i18n/index.ts';
import { tStudy } from '../../../i18n/pages.ts';
import { tCommon } from '../../../i18n/common.ts';
import { langPath } from '../../../lib/url.ts';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = (k: Parameters<typeof tStudy>[1]) => tStudy(lang, k);
const modes = [
  ['reviewTitle', 'reviewBody'],
  ['quizTitle', 'quizBody'],
  ['imagesTitle', 'imagesBody'],
  ['chainTitle', 'chainBody'],
  ['plannerTitle', 'plannerBody'],
  ['lastWeekTitle', 'lastWeekBody'],
] as const;
---

<BaseLayout lang={lang} title={t('title')} description={t('metaDescription')} tab="study">
  <header class="page-head">
    <h1>{t('title')}</h1>
    <p class="lede">{t('intro')}</p>
  </header>
  <ul class="grid">
    {
      modes.map(([title, body]) => (
        <li>
          <article class="card mode-card">
            <h2>{t(title)}</h2>
            <p class="muted">{t(body)}</p>
            <p class="small" style="margin:0">
              <span class="badge badge-planned">{t('availableWhen')}</span>
            </p>
          </article>
        </li>
      ))
    }
  </ul>
  <p><a href={langPath(lang, 'about/roadmap/')}>{tCommon(lang, 'roadmap')} →</a></p>
</BaseLayout>

<style>
  .mode-card h2 {
    margin-top: 0;
    font-size: var(--step-1);
  }
</style>
