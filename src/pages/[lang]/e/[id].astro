---
/**
 * Canonical entity page (NAVIGATION_SPEC §4, CONTENT_SCHEMA §1).
 * Generated only for visible entities (published, or drafts with PREVIEW_DRAFTS=1).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/nav/Breadcrumb.astro';
import EntityHeader from '../../../components/entity/EntityHeader.astro';
import RelatedPanel from '../../../components/entity/RelatedPanel.astro';
import ImageViewer from '../../../components/horizontal/ImageViewer.astro';
import ModuleTree from '../../../components/horizontal/ModuleTree.astro';
import ChapterIndex from '../../../components/horizontal/ChapterIndex.astro';
import ChapterDialog from '../../../components/horizontal/ChapterDialog.astro';
import { tHz } from '../../../i18n/horizontal.ts';
import { LENSES } from '../../../lib/schema.ts';
import { withCrossLinks, imageById, patternsForEntity, SECTION_FOR_ROLE } from '../../../lib/horizontal.ts';
import EntityActions from '../../../components/entity/EntityActions.astro';
import EntityPinned from '../../../components/entity/EntityPinned.astro';
import CardPager from '../../../components/entity/CardPager.astro';
import SectionToc from '../../../components/entity/SectionToc.astro';
import SelfExplain from '../../../components/entity/SelfExplain.astro';
import ExamQuestions from '../../../components/entity/ExamQuestions.astro'; // study branch: exam questions + quick-check confidence
import EntityPathways from '../../../components/pathway/EntityPathways.astro'; // v2/3d-pathways: compact pathway block
import { LANGS, fmt, type Lang } from '../../../i18n/index.ts';
import { tEntity, tAtlas } from '../../../i18n/pages.ts';
import { SECTIONS, QUICK_CHECK, PRINT_SECTIONS, sectionTitle } from '../../../i18n/sections.ts';
import { langPath } from '../../../lib/url.ts';
import { siteData, entityBody, sources as getSources } from '../../../lib/content.ts';
import { splitSections } from '../../../lib/sections.ts';
import { primaryTerm, prevNext } from '../../../lib/lenses.ts';
import '../../../styles/entity.css';
import '../../../styles/horizontal.css';

export async function getStaticPaths() {
  const { entities } = await siteData('it'); // only the ids: the same in both languages
  return entities.flatMap((e) => LANGS.map((lang) => ({ params: { lang, id: e.id } })));
}

const lang = Astro.params.lang as Lang;
const id = Astro.params.id!;
const t = (k: Parameters<typeof tEntity>[1]) => tEntity(lang, k);
const data = await siteData(lang);
const entity = data.entityById.get(id)!;
const body = await entityBody(id, lang);
const split = splitSections(await withCrossLinks(body?.rendered?.html ?? '', lang));
if (split.unknown.length) throw new Error(`${id}/${lang}.md: non-canonical H2 titles: ${split.unknown.join(' | ')}`);

const primary = primaryTerm(entity);
const systemTax = data.taxonomy.get('system');
const termLabel = primary ? systemTax?.terms.find((x) => x.id === primary.term)?.label[lang] ?? primary.term : undefined;
const order = primary ? (data.membership.get('system')?.get(primary.term) ?? []) : [];
const { prev, next } = prevNext(order, id);
const nameOf = (eid: string) => data.entityById.get(eid)?.names[lang] ?? eid;
/** A neighbour for the pager beside the breadcrumb, in the default order or in a lens context (`via`). */
const card = (eid: string | undefined, via?: string) =>
  eid ? { href: langPath(lang, `e/${eid}/${via ? `?via=${via}` : ''}`), name: nameOf(eid) } : undefined;
const allSources = await getSources();
const cited = entity.sources.map((s) => ({ ...s, src: allSources.find((x) => x.id === s.source) }));
const relations = data.relations.get(id) ?? [];

const crumbs = [
  { label: tAtlas(lang, 'title'), href: langPath(lang, 'atlas/') },
  ...(primary && systemTax
    ? [
        { label: systemTax.label[lang], href: langPath(lang, 'atlas/system/') },
        { label: termLabel!, href: langPath(lang, `atlas/system/${primary.term}/`) },
      ]
    : []),
  { label: entity.names[lang] },
];
const toc = [...SECTIONS, QUICK_CHECK];
/** Section names for this card's kind (a technique card remaps ten titles); `short` is the contents-list label. */
const sectionName = (sectionId: string, short = false) => sectionTitle(sectionId, entity.kind, lang, short);
/** "Continue" targets after section i: the next one in full mode and, if different, the next one in quick mode. */
const nextOf = (i: number) => {
  const full = toc[i + 1];
  const quick = toc.slice(i + 1).find((s) => s.quick);
  return { full, quick: toc[i]!.quick && quick?.id !== full?.id ? quick : undefined };
};
const CALLOUTS = new Set(['high-yield', 'traps', 'mnemonics']);
const attr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
/** Markdown tables scroll inside a labelled, focusable region (WCAG 2.1.1, 1.4.10). */
const wrapTables = (html: string, section: string) =>
  html
    .replace(/<table>/g, `<div class="table-scroll" role="region" tabindex="0" aria-label="${attr(fmt(t('tableOf'), { section }))}"><table>`)
    .replace(/<\/table>/g, '</table></div>');
const imgs = await imageById();
const imagesIn = (section: string) => entity.images.filter((i) => SECTION_FOR_ROLE[i.role] === section);
const entityPatterns = await patternsForEntity(id);

// Lens context (?via=lens:term): breadcrumb + prev/next for every lens term of this entity, swapped in by lens-context.ts.
const contexts = LENSES.flatMap((lens) =>
  entity.lenses[lens].map((term) => {
    const tax = data.taxonomy.get(lens);
    const ids = data.membership.get(lens)?.get(term) ?? [];
    return {
      via: `${lens}:${term}`,
      lens,
      term,
      lensLabel: tax?.label[lang] ?? lens,
      termLabel: tax?.terms.find((x) => x.id === term)?.label[lang] ?? term,
      ...prevNext(ids, id),
    };
  }),
);
---

<BaseLayout lang={lang} title={entity.names[lang]} description={entity.summary[lang]} tab="atlas">
  <a slot="skip" class="skip-link" href={`#${toc[0]!.id}`}>{t('skipToText')}</a>
  <Fragment slot="sidebar"><ModuleTree lang={lang} data={data} current={id} /></Fragment>
  <ChapterIndex slot="topbar" lang={lang} />
  <ChapterDialog slot="dialogs" lang={lang} data={data} current={id} />
  <div class="crumb-row" data-lens-crumb>
    <Breadcrumb lang={lang} items={crumbs} />
    {termLabel && <CardPager lang={lang} prev={card(prev)} next={card(next)} />}
  </div>
  {
    contexts.map((c) => (
      <template data-via-crumb={c.via} data-pagefind-ignore>
        <Breadcrumb
          lang={lang}
          items={[
            { label: tAtlas(lang, 'title'), href: langPath(lang, 'atlas/') },
            { label: c.lensLabel, href: langPath(lang, `atlas/${c.lens}/`) },
            { label: c.termLabel, href: langPath(lang, `atlas/${c.lens}/${c.term}/`) },
            { label: entity.names[lang] },
          ]}
        />
        <CardPager lang={lang} prev={card(c.prev, c.via)} next={card(c.next, c.via)} />
      </template>
    ))
  }
  <article class="entity" data-entity={id}>
    <div class="read-progress js-only" aria-hidden="true"><span data-read-progress></span></div>
    {entity.status === 'draft' && <p class="notice notice-caution draft-banner" role="note">{t('draftBanner')}</p>}
    <EntityHeader lang={lang} entity={entity} data={data}>
      <EntityActions lang={lang} entity={entity} />
      <EntityPinned slot="pinned" lang={lang} entity={entity} />
    </EntityHeader>

    <div class="entity-layout">
      <SectionToc
        lang={lang}
        items={toc.map((s) => ({ id: s.id, label: sectionName(s.id, true), quick: s.quick }))}
        related={relations.length > 0 ? 'related' : undefined}
        cardNav={termLabel ? 'card-nav' : undefined}
        next={card(next)}
      />

      <div class="entity-body">
        <section class="objectives card" aria-labelledby="objectives-title">
          {/* With JS the list folds behind the title, made a toggle (entity.css) */}
          <h2 id="objectives-title" class="kicker fold-head">
            <span class="fold-label">{t('objectives')}</span>
            <button type="button" class="fold-toggle js-only" aria-expanded="false" aria-controls="objectives-list" data-fold data-pagefind-ignore>
              {t('objectives')}<span class="chevron" aria-hidden="true"></span>
            </button>
          </h2>
          <ul id="objectives-list">{entity.learningObjectives.map((o) => <li>{o[lang]}</li>)}</ul>
        </section>

        {
          entity.editionDependent && entity.editionNote && (
            <aside class="notice edition-note" aria-label={t('editionDependent')}>
              <strong>{t('editionDependent')}:</strong> {entity.editionNote[lang]}
            </aside>
          )
        }

        {
          SECTIONS.map((s, i) => (
            <section
              class="entity-section"
              id={s.id}
              data-quick={String(s.quick)}
              data-callout={CALLOUTS.has(s.id) ? s.id : undefined}
              data-print={(PRINT_SECTIONS as readonly string[]).includes(s.id) ? '' : undefined}
              aria-labelledby={`${s.id}-title`}
            >
              <h2 id={`${s.id}-title`} class="section-title">
                <button type="button" class="section-toggle" aria-expanded="true" aria-controls={`${s.id}-body`} data-section-toggle>
                  <span>{sectionName(s.id)}</span>
                  <span class="chevron js-only" aria-hidden="true" />
                </button>
              </h2>
              <div class="recall js-only" data-recall>
                <p>{fmt(tHz(lang, 'recallPrompt'), { section: sectionName(s.id) })}</p>
                <button type="button" class="btn btn-small" data-recall-reveal>{tHz(lang, 'recallReveal')}</button>
              </div>
              <div class="section-body prose" id={`${s.id}-body`}>
                <Fragment set:html={wrapTables(split.sections.get(s.id) ?? '', sectionName(s.id))} />
                {imagesIn(s.id).map((img) => <ImageViewer lang={lang} image={imgs.get(img.id)} id={img.id} />)}
                {
                  nextOf(i).full && (
                    <p class="section-next" data-pagefind-ignore>
                      <a class={nextOf(i).quick ? 'next-full' : undefined} href={`#${nextOf(i).full!.id}`}>
                        {fmt(t('continueTo'), { section: sectionName(nextOf(i).full!.id) })} <span aria-hidden="true">↓</span>
                      </a>
                      {nextOf(i).quick && (
                        <a class="next-quick" href={`#${nextOf(i).quick!.id}`}>
                          {fmt(t('continueTo'), { section: sectionName(nextOf(i).quick!.id) })} <span aria-hidden="true">↓</span>
                        </a>
                      )}
                    </p>
                  )
                }
              </div>
            </section>
          ))
        }

        <section class="entity-section" id={QUICK_CHECK.id} data-quick="true" data-callout="quick-check" aria-labelledby="quick-check-title">
          <h2 id="quick-check-title" class="section-title">
            <button type="button" class="section-toggle" aria-expanded="true" aria-controls="quick-check-body" data-section-toggle>
              <span>{QUICK_CHECK.title[lang]}</span>
              <span class="chevron js-only" aria-hidden="true"></span>
            </button>
          </h2>
          <div class="section-body" id="quick-check-body">
            <ol class="quick-check">
              {
                entity.quickCheck.map((q) => (
                  <li>
                    <p class="qc-q">{q.q[lang]}</p>
                    <details>
                      <summary>{t('showAnswer')}</summary>
                      <p>{q.a[lang]}</p>
                    </details>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>
        <ExamQuestions lang={lang} entity={entity} />

        <SelfExplain lang={lang} prompts={entity.selfExplain} />

        {/* v2/3d-pathways: pathways of this entity (renders nothing when there are none) */}
        <EntityPathways lang={lang} entity={id} />

        <RelatedPanel lang={lang} groups={relations} data={data} />
        {
          entityPatterns.length > 0 && (
            <section class="related" aria-labelledby="entity-patterns-title">
              <h2 id="entity-patterns-title">{tHz(lang, 'patternsOnEntity')}</h2>
              <ul>
                {entityPatterns.map((p) => (
                  <li>
                    <a href={langPath(lang, `pattern/${p.id}/`)}>{p.names[lang]}</a>
                    <span class="small muted">{p.summary[lang]}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="sources" aria-labelledby="sources-title">
          <h2 id="sources-title">{t('sources')}</h2>
          <ul>
            {
              cited.map((c) => (
                <li>
                  {c.src ? <cite>{c.src.title}</cite> : c.source}
                  {c.src?.edition && `, ed. ${c.src.edition}`}
                  {c.chapter && ` · ${lang === 'it' ? 'cap.' : 'ch.'} ${c.chapter}`}
                  {c.pages && ` · pp. ${c.pages}`}
                </li>
              ))
            }
          </ul>
          <p class="small">
            <a href={langPath(lang, 'about/report/')}>{t('reportThis')}</a>
          </p>
        </section>

        {/* The section list's last entry and the link under it read the next card from here (lens-context.ts) */}
        <div data-lens-nav id="card-nav">
        {
          (prev || next) && termLabel && (
            <nav class="prev-next" aria-label={termLabel}>
              {prev && (
                <a rel="prev" href={langPath(lang, `e/${prev}/`)}>
                  <span class="small muted">{fmt(t('prevIn'), { term: termLabel })}</span>
                  <span>← {nameOf(prev)}</span>
                </a>
              )}
              {next && (
                <a rel="next" href={langPath(lang, `e/${next}/`)} data-name={nameOf(next)}>
                  <span class="small muted">{fmt(t('nextIn'), { term: termLabel })}</span>
                  <span>{nameOf(next)} →</span>
                </a>
              )}
            </nav>
          )
        }
        </div>
        {
          contexts.map((c) => (
            <template data-via-nav={c.via} data-pagefind-ignore>
              {(c.prev || c.next) && (
                <nav class="prev-next" aria-label={c.termLabel}>
                  {c.prev && (
                    <a rel="prev" href={langPath(lang, `e/${c.prev}/?via=${c.via}`)}>
                      <span class="small muted">{fmt(t('prevIn'), { term: c.termLabel })}</span>
                      <span>← {nameOf(c.prev)}</span>
                    </a>
                  )}
                  {c.next && (
                    <a rel="next" href={langPath(lang, `e/${c.next}/?via=${c.via}`)} data-name={nameOf(c.next)}>
                      <span class="small muted">{fmt(t('nextIn'), { term: c.termLabel })}</span>
                      <span>{nameOf(c.next)} →</span>
                    </a>
                  )}
                </nav>
              )}
            </template>
          ))
        }
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '../../../scripts/entity.ts';
  import '../../../scripts/lens-context.ts';
  import '../../../scripts/glossary.ts';
  import '../../../scripts/image-viewer.ts';
</script>
