---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langPaths, fmt, type Lang } from '../../i18n/index.ts';
import { tCommon, SITE_NAME } from '../../i18n/common.ts';
import { tHome } from '../../i18n/pages.ts';
import { langPath } from '../../lib/url.ts';
import { siteData } from '../../lib/content.ts';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = (k: Parameters<typeof tHome>[1]) => tHome(lang, k);
const { modules, entities } = await siteData(lang);
const published = modules.filter((m) => m.status === 'published').length;
const pct = Math.round((published / modules.length) * 100);
// Cards per module: published cards, and M = published + planned entries. Planned names are never shown, only counts.
const rows = modules.map((m) => {
  const own = entities.filter((e) => e.module === m.id);
  // a module has no page of its own: its lens page is the system most of its cards belong to
  const systems = own.flatMap((e) => e.lenses.system.slice(0, 1));
  const system = [...new Set(systems)].sort((a, b) => systems.filter((x) => x === b).length - systems.filter((x) => x === a).length)[0];
  return {
    m,
    cards: own.length,
    total: own.length + m.planned.length,
    href: m.status === 'published' && system ? langPath(lang, `atlas/system/${system}/`) : undefined,
  };
});
const sum = (list: typeof rows) => ({
  cards: list.reduce((n, r) => n + r.cards, 0),
  total: list.reduce((n, r) => n + r.total, 0),
});
const cardsAll = sum(rows);
const sections = (['I', 'II', 'III'] as const).map((s) => ({
  id: s,
  label: tCommon(lang, `section${s}`),
  total: modules.filter((m) => m.section === s).length,
  published: modules.filter((m) => m.section === s && m.status === 'published').length,
  rows: rows.filter((r) => r.m.section === s),
  ...(() => {
    const c = sum(rows.filter((r) => r.m.section === s));
    return { cards: c.cards, cardsTotal: c.total };
  })(),
}));
---

<BaseLayout lang={lang} title={SITE_NAME} description={t('metaDescription')} tab="home">
  <header class="hero">
    <p class="kicker">{lang === 'it' ? 'Anatomia patologica · Pathology' : 'Pathology · Anatomia patologica'}</p>
    <h1>Atlante <em>di Patologia</em></h1>
    <p class="lede">{tCommon(lang, 'tagline')}</p>
  </header>

  <section class="status card" aria-labelledby="status-title">
    <h2 id="status-title" class="kicker">{t('status')}</h2>
    <p>{t('statusBody')}</p>
  </section>

  <section aria-labelledby="start-title">
    <h2 id="start-title">{t('startHere')}</h2>
    <ul class="grid">
      <li>
        <a class="card link-card" href={langPath(lang, 'atlas/')}>
          <h3>{t('atlasCardTitle')} →</h3>
          <p class="muted">{t('atlasCardBody')}</p>
        </a>
      </li>
      <li>
        <a class="card link-card" href={langPath(lang, 'study/')}>
          <h3>{t('studyCardTitle')} →</h3>
          <p class="muted">{t('studyCardBody')}</p>
        </a>
      </li>
    </ul>
  </section>

  <section aria-labelledby="progress-title">
    <h2 id="progress-title">{t('progress')}</h2>
    <p>{fmt(t('progressSummary'), { published, total: modules.length })}</p>
    <div class="progress" role="img" aria-label={fmt(t('progressSummary'), { published, total: modules.length })}>
      <span style={`width:${Math.max(pct, 1)}%`}></span>
    </div>
    <p data-cards-total={`${cardsAll.cards}/${cardsAll.total}`}>
      {fmt(t('cardsSummary'), { published: cardsAll.cards, total: cardsAll.total })}
    </p>
    <dl class="section-progress">
      {
        sections.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>
              {s.published} / {s.total} · <span class="badge badge-planned">{tCommon(lang, 'planned')}: {s.total - s.published}</span>
              <br />
              <span class="small muted" data-section-cards={`${s.cards}/${s.cardsTotal}`}>
                {fmt(t('cardsSummary'), { published: s.cards, total: s.cardsTotal })}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
    {
      sections.map((s) => (
        <>
          <h3>{s.label}</h3>
          <ul class="module-cards">
            {s.rows.map((r) => (
              <li data-module-cards={`${r.cards}/${r.total}`}>
                {r.href ? <a href={r.href}>{r.m.label[lang]}</a> : <span>{r.m.label[lang]}</span>}
                <span class="small muted">{fmt(t('cardsShort'), { published: r.cards, total: r.total })}</span>
                {r.m.status !== 'published' && <span class="badge badge-planned">{tCommon(lang, 'planned')}</span>}
              </li>
            ))}
          </ul>
        </>
      ))
    }
    <p><a href={langPath(lang, 'about/roadmap/')}>{t('seeRoadmap')}</a></p>
  </section>

  {/* The medical disclaimer is in the footer of every page and in the first-launch notice. */}
</BaseLayout>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-6);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--rule);
    background:
      radial-gradient(circle at 92% 30%, var(--eosin-soft) 0 5.5rem, transparent 5.6rem),
      radial-gradient(circle at 86% 62%, var(--hema-soft) 0 2.2rem, transparent 2.3rem);
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero h1 em {
    font-weight: 400;
    color: var(--eosin);
  }
  .status {
    max-width: var(--measure);
    border-left: 4px solid var(--hema);
  }
  /* From 600 px the card keeps only its own border: the stripe added nothing to a bordered card with a kicker.
     Phones keep their page. */
  @media (min-width: 600px) {
    .status {
      border-left: 1px solid var(--rule);
    }
  }
  .status p {
    margin: 0;
  }
  .section-progress {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    margin-top: var(--space-4);
  }
  .section-progress dt {
    font-weight: 700;
  }
  .section-progress dd {
    margin: 0;
  }
  .module-cards {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }
  .module-cards li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-1) 0;
  }
</style>
