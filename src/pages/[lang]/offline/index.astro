---
/** Offline fallback: the service worker serves this when a page is neither online nor saved. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langPaths, type Lang } from '../../../i18n/index.ts';
import { tOffline } from '../../../i18n/offline.ts';
import { langPath } from '../../../lib/url.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = (k: Parameters<typeof tOffline>[1]) => tOffline(lang, k);
---

<BaseLayout lang={lang} title={t('fallbackTitle')} description={t('fallbackMeta')} searchable={false} noindex>
  <header class="page-head">
    <h1>{t('fallbackTitle')}</h1>
    <p class="lede">{t('fallbackBody')}</p>
  </header>
  <p class="offline-actions">
    <button type="button" class="btn btn-primary js-only" data-retry>{t('retry')}</button>
    <a class="btn" href={langPath(lang)}>{t('goHome')}</a>
    <a class="btn" href={langPath(lang, 'me/offline/')}>{t('manage')}</a>
  </p>
</BaseLayout>

<script>
  document.querySelector('[data-retry]')?.addEventListener('click', () => location.reload());
</script>

<style>
  .offline-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
