---
/**
 * Pattern Page (CONTENT_SCHEMA §3, NAVIGATION_SPEC §5): overview text, the
 * cross-organ comparison matrix (real table, sticky first column, labelled
 * focusable scroll region), images per row, related cards.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/nav/Breadcrumb.astro';
import ImageViewer from '../../../components/horizontal/ImageViewer.astro';
import { LANGS, fmt, formatDate, type Lang } from '../../../i18n/index.ts';
import { tAtlas, tEntity } from '../../../i18n/pages.ts';
import { tHz } from '../../../i18n/horizontal.ts';
import { langPath } from '../../../lib/url.ts';
import { siteData, patterns, patternBody, sources as getSources } from '../../../lib/content.ts';
import { withCrossLinks, imageById, anyEntityName } from '../../../lib/horizontal.ts';
import '../../../styles/entity.css';
import '../../../styles/horizontal.css';

export async function getStaticPaths() {
  return (await patterns()).flatMap((p) => LANGS.map((lang) => ({ params: { lang, id: p.id }, props: { pattern: p } })));
}

const lang = Astro.params.lang as Lang;
const { pattern } = Astro.props as { pattern: Awaited<ReturnType<typeof patterns>>[number] };
const t = (k: Parameters<typeof tHz>[1]) => tHz(lang, k);
const data = await siteData();
const body = await patternBody(pattern.id, lang);
const html = await withCrossLinks(body?.rendered?.html ?? '', lang);
const imgs = await imageById();
const other = lang === 'it' ? 'en' : 'it';

const processTax = data.taxonomy.get('process');
const processLabel = processTax?.terms.find((x) => x.id === pattern.process)?.label[lang] ?? pattern.process;
const processHasPage = data.membership.get('process')?.has(pattern.process);

const rows = await Promise.all(
  pattern.matrix.rows.map(async (r) => ({
    ...r,
    name: await anyEntityName(r.entity, lang),
    visible: data.entityById.has(r.entity),
    images: pattern.images.filter((i) => i.entity === r.entity),
  })),
);
const hasImages = pattern.images.length > 0;
const allSources = await getSources();
const captionId = 'matrix-caption';
---

<BaseLayout lang={lang} title={pattern.names[lang]} description={pattern.summary[lang]} tab="atlas">
  <Breadcrumb
    lang={lang}
    items={[
      { label: tAtlas(lang, 'title'), href: langPath(lang, 'atlas/') },
      { label: processTax?.label[lang] ?? 'process', href: langPath(lang, 'atlas/process/') },
      ...(processHasPage ? [{ label: processLabel, href: langPath(lang, `atlas/process/${pattern.process}/`) }] : []),
      { label: pattern.names[lang] },
    ]}
  />
  <article class="pattern">
    {pattern.status === 'draft' && <p class="notice notice-caution draft-banner" role="note">{t('draftBanner')}</p>}
    <header class="entity-head">
      <p class="kicker">{t('patternKicker')}</p>
      <h1>{pattern.names[lang]}</h1>
      <p class="muted" lang={other}><i>{pattern.names[other]}</i></p>
      <p class="lede">{pattern.summary[lang]}</p>
      <ul class="badges">
        <li>
          {
            pattern.reviewStatus === 'expert-reviewed' ? (
              <span class="badge badge-published">✓ {tEntity(lang, 'reviewExpert')}</span>
            ) : (
              <span class="badge badge-eosin">⚠︎ {tEntity(lang, 'reviewUnreviewed')}</span>
            )
          }
        </li>
        <li><span class="badge">{fmt(tEntity(lang, 'updated'), { date: formatDate(lang, pattern.lastUpdated) })}</span></li>
        <li><span class="badge">{t('patternProcess')}: {processLabel}</span></li>
      </ul>
    </header>

    <div class="prose" set:html={html} />

    <section aria-labelledby="matrix-title">
      <h2 id="matrix-title">{t('matrixTitle')}</h2>
      <div class="table-scroll" role="region" aria-labelledby={captionId} tabindex="0">
        <table class="matrix">
          <caption id={captionId}>{fmt(t('scrollTable'), { name: pattern.names[lang] })}</caption>
          <thead>
            <tr>
              {pattern.matrix.columns.map((c) => <th scope="col">{c[lang]}</th>)}
              {hasImages && <th scope="col">{t('matrixImages')}</th>}
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">
                    {r.visible ? (
                      <a href={langPath(lang, `e/${r.entity}/`)}>{r.name}</a>
                    ) : (
                      <span>
                        {r.name} <span class="badge badge-planned">{t('planned')}</span>
                      </span>
                    )}
                  </th>
                  {r.cells.map((c) => <td>{c[lang]}</td>)}
                  {hasImages && (
                    <td>
                      {r.images.map((i, n) => (
                        <a class="matrix-thumb" href={`#fig-${i.id}`}>
                          {t(`img_${imgs.get(i.id)?.kind ?? 'micro'}`)}
                          {r.images.length > 1 ? ` ${n + 1}` : ''}
                        </a>
                      ))}
                    </td>
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      hasImages && (
        <section aria-labelledby="images-title">
          <h2 id="images-title">{t('imagesTitle')}</h2>
          {rows
            .filter((r) => r.images.length > 0)
            .map((r) => (
              <>
                <h3>{r.name}</h3>
                {r.images.map((i) => <ImageViewer lang={lang} image={imgs.get(i.id)} id={i.id} />)}
              </>
            ))}
        </section>
      )
    }

    <section class="related" aria-labelledby="pattern-cards-title">
      <h2 id="pattern-cards-title">{t('patternCards')}</h2>
      <ul>
        {
          rows.map((r) => (
            <li>
              {r.visible ? <a href={langPath(lang, `e/${r.entity}/`)}>{r.name}</a> : r.name}
              {r.visible && <span class="small muted"> — {data.entityById.get(r.entity)!.summary[lang]}</span>}
            </li>
          ))
        }
      </ul>
      {
        rows.filter((r) => r.visible).length >= 2 && (
          <p>
            <a
              class="btn btn-small"
              href={langPath(lang, `compare/?ids=${rows.filter((r) => r.visible).slice(0, 4).map((r) => r.entity).join(',')}`)}
            >
              {t('compareTitle')}
            </a>
          </p>
        )
      }
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">{tEntity(lang, 'sources')}</h2>
      <ul>
        {
          pattern.sources.map((c) => {
            const src = allSources.find((x) => x.id === c.source);
            return (
              <li>
                {src ? <cite>{src.title}</cite> : c.source}
                {src?.edition && `, ed. ${src.edition}`}
                {c.chapter && ` · ${lang === 'it' ? 'cap.' : 'ch.'} ${c.chapter}`}
                {c.pages && ` · pp. ${c.pages}`}
              </li>
            );
          })
        }
      </ul>
      <p class="small"><a href={langPath(lang, 'about/report/')}>{tEntity(lang, 'reportThis')}</a></p>
    </section>
  </article>
</BaseLayout>

<script>
  import '../../../scripts/glossary.ts';
  import '../../../scripts/image-viewer.ts';
</script>
