---
import StudyPage from '../../../../components/study/StudyPage.astro';
import PersonalList from '../../../../islands/PersonalList.tsx';
import { langPaths, type Lang } from '../../../../i18n/index.ts';
import { tS } from '../../../../i18n/study.ts';
import { tNav } from '../../../../i18n/nav.ts';
import { langPath } from '../../../../lib/url.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---

<StudyPage lang={lang} tab="me" title={tS(lang, 'bookmarks')} intro={tS(lang, 'bookmarksIntro')} parent={{ label: tNav(lang, 'me'), href: langPath(lang, 'me/') }}>
  <PersonalList client:load lang={lang} kind="bookmarks" />
</StudyPage>
