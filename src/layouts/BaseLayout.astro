---
/**
 * Shell for every localized page: head (lang, canonical, hreflang, theme
 * before paint), skip link, top bar, primary navigation, first-launch notice,
 * <main> (the only part Pagefind indexes) and the footer with the disclaimer.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/print.css';
import { LANGS, type Lang } from '../i18n/index.ts';
import { tCommon, SITE_NAME } from '../i18n/common.ts';
import type { Tab } from '../i18n/nav.ts';
import { alternate, url } from '../lib/url.ts';
import TopBar from '../components/nav/TopBar.astro';
import PrimaryNav from '../components/nav/PrimaryNav.astro';
import Footer from '../components/nav/Footer.astro';
import DisclaimerNotice from '../components/nav/DisclaimerNotice.astro';
import UpdateNotice from '../components/offline/UpdateNotice.astro';
// Same hashed files fonts.css references; preloaded so font-display: optional finds them in time (D049).
import bodyFont from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  tab?: Tab;
  /** Index <main> in Pagefind (false for 404 and utility pages). */
  searchable?: boolean;
  /** Emit hreflang alternates (the page exists in both languages). */
  alternates?: boolean;
  noindex?: boolean;
}
const { lang, title, description, tab, searchable = true, alternates = true, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* A noindex page (404) has no canonical URL: /404/ itself does not exist. */}
    {!noindex && <link rel="canonical" href={abs(path)} />}
    {alternates && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(alternate(l, path))} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={abs(url())} />}
    {/* = --paper in tokens.css; shell.ts follows a forced theme */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f1e7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b1c21" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <script is:inline>
      // Before paint: preferences that change layout or colours (no flash).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var s = localStorage;
          var t = s.getItem('ap-theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
          if (s.getItem('ap-disclaimer') === '1') d.dataset.disclaimerAck = '';
          if (s.getItem('ap-sidebar') === 'collapsed') d.dataset.sidebar = 'collapsed';
          if (s.getItem('ap-mode') === 'quick') d.dataset.mode = 'quick';
          var z = s.getItem('ap-text');
          if (z === 's' || z === 'l' || z === 'xl') d.classList.add('text-' + z);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body data-tab={tab}>
    <a class="skip-link" href="#main">{tCommon(lang, 'skipToContent')}</a>
    {/* Reading pages add a second one, straight to the text of the card (past its header and tools) */}
    <slot name="skip" />
    <div class="app">
      <TopBar lang={lang} langSwitchToHome={!alternates}><slot name="topbar" /></TopBar>
      <PrimaryNav lang={lang} current={tab}><slot name="sidebar" /></PrimaryNav>
      <main id="main" tabindex="-1">
        <DisclaimerNotice lang={lang} />
        <div class="page" data-pagefind-body={searchable ? '' : undefined}>
          <slot />
        </div>
      </main>
      <Footer lang={lang} />
    </div>
    <UpdateNotice lang={lang} />
    {/* Page dialogs (the chapter index): after the page and outside <main>, so they neither delay the top bar nor
        reach the search index */}
    <slot name="dialogs" />
    <script>
      import '../scripts/shell.ts';
      // Personal-layer elements (<ap-recent>, <ap-resume>, <ap-path-progress>…) load their code only where used.
      if (document.querySelector('ap-recent, ap-resume, ap-path-progress, ap-due-count, ap-export-reminder')) void import('../scripts/personal.ts');
    </script>
  </body>
</html>
