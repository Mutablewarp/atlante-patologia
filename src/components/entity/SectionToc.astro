---
/**
 * Contents of a reading page (entity, pattern): a sticky chip strip on phones
 * and tablets, a side list on desktop (entity.css). shell.ts marks the entry of
 * the section being read; `quick` lets Quick mode hide an entry.
 * Entity pages, from 600 px: the list ends with the related cards and the next card (the links at the end of the
 * card), and from 1024 px the next card itself is one click away under the list. lens-context.ts gives both the next
 * card of the lens the reader came from; with no next card in the order shown they stay hidden.
 */
import type { Lang } from '../../i18n/index.ts';
import { fmt } from '../../i18n/index.ts';
import { tEntity } from '../../i18n/pages.ts';

interface Props {
  lang: Lang;
  items: { id: string; label: string; quick?: boolean }[];
  /** Ids of the related-cards section and of the previous/next block, when the page has them. */
  related?: string;
  cardNav?: string;
  next?: { href: string; name: string };
}
const { lang, items, related, cardNav, next } = Astro.props;
const [before, after] = tEntity(lang, 'nextEntry').split('{name}');
---

<nav class="section-toc" aria-label={tEntity(lang, 'onThisPage')}>
  <p class="toc-title" aria-hidden="true">{tEntity(lang, 'onThisPage')}</p>
  <ol>
    {
      items.map((s) => (
        <li data-quick={s.quick === undefined ? undefined : String(s.quick)}>
          <a href={`#${s.id}`}>{s.label}</a>
        </li>
      ))
    }
    {
      related && (
        <li class="toc-extra">
          <a href={`#${related}`}>{tEntity(lang, 'related')}</a>
        </li>
      )
    }
    {
      cardNav && (
        <li class="toc-extra" hidden={!next} data-next-entry>
          <a href={`#${cardNav}`}>
            {before}
            <span data-next-name>{next?.name}</span>
            {after}
            <span aria-hidden="true"> →</span>
          </a>
        </li>
      )
    }
  </ol>
  {
    cardNav && (
      <p class="toc-next" hidden={!next} data-next-entry>
        {/* Named "Successiva: <card>", the visible label first (SC 2.5.3); lens-context.ts fills data-label */}
        <a
          rel="next"
          href={next?.href}
          aria-label={next && fmt(tEntity(lang, 'nextEntry'), { name: next.name })}
          data-label={tEntity(lang, 'nextEntry')}
          data-next-link
        >
          {tEntity(lang, 'nextShort')}<span aria-hidden="true"> →</span>
        </a>
      </p>
    )
  }
</nav>
