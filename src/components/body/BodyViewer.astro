---
/**
 * Stage part of the markup contract (docs/BODY_SPEC.md §5): the two posters, the hidden canvas and label, the key
 * help, the controls and the status line. Static HTML without script; the element script shows the buttons.
 */
import type { Lang } from '../../i18n/index.ts';
import { tBody } from '../../i18n/body.ts';
import { langPath, url } from '../../lib/url.ts';

interface Props {
  lang: Lang;
  /** the `credit` string of `public/anatomy/manifest.json` */
  credit: string;
}
const { lang, credit } = Astro.props;
const t = (k: Parameters<typeof tBody>[1]) => tBody(lang, k);
const acts = ['left', 'right', 'up', 'down', 'in', 'out', 'front', 'back', 'side', 'reset', 'prev', 'next'] as const;
const posters = ['light', 'dark'] as const;
---

<figure class="body-stage" data-stage tabindex="0" aria-label={t('stage')} aria-describedby="body-help">
  {
    posters.map((p) => (
      <picture data-poster class={`poster-${p}`}>
        <source type="image/avif" srcset={url(`anatomy/poster-${p}.avif`)} />
        <source type="image/webp" srcset={url(`anatomy/poster-${p}.webp`)} />
        <img src={url(`anatomy/poster-${p}.webp`)} width="960" height="1200" alt="" />
      </picture>
    ))
  }
  <canvas data-canvas hidden></canvas>
  <p class="body-label" data-label hidden></p>
</figure>
<p id="body-help" class="body-help js-only">{t('help')}</p>
<div class="body-controls js-only" role="group" aria-label={t('controls')}>
  <button type="button" class="btn btn-primary" data-load>{t('load')}</button>
  {
    acts.map((a) => (
      <button type="button" class="btn" data-act={a} hidden>
        {t(a)}
      </button>
    ))
  }
  <button type="button" class="btn" data-off hidden>{t('off')}</button>
</div>
<p class="body-status js-only" data-status role="status"></p>
<p class="body-credit">
  {credit}. {t('creditHra')} {t('creditChanges')}
  <a href={langPath(lang, 'about/licenses/')}>{t('creditMore')}</a>
</p>
