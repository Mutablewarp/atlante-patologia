---
/** Compact block of every pathway that belongs to this entity (included once in pages/[lang]/e/[id].astro). */
import type { Lang } from '../../i18n/index.ts';
import { tPw } from '../../i18n/pathway.ts';
import { pathways, structureById } from '../../lib/pathways.ts';
import Pathway from './Pathway.astro';
import PathwaySources from './PathwaySources.astro';

interface Props {
  lang: Lang;
  entity: string;
}
const { lang, entity } = Astro.props;
const list = (await pathways()).filter((p) => p.entity === entity);
const structures = await structureById();
---

{
  list.map((p) => (
    <section class="entity-pathway" aria-labelledby={`pathway-${p.id}-title`}>
      <p class="kicker kicker-sentence">{tPw(lang, 'onEntity')}</p>
      <h2 id={`pathway-${p.id}-title`}>{p.title[lang]}</h2>
      <p class="small muted">{p.summary[lang]}</p>
      <Pathway lang={lang} pathway={p} structures={structures} compact />
      {/* The steps report what these sources say (sources-differ asides): the card cites them too (D062). */}
      <PathwaySources lang={lang} pathway={p} id={`pathway-${p.id}-sources`} title={tPw(lang, 'sourcesOfPathway')} heading="h3" />
    </section>
  ))
}
