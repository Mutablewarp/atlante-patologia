---
/** Sticky top bar: brand (phone/tablet), global search (desktop), language, theme; the default slot opens the tools (the chapter button of entity pages). */
import type { Lang } from '../../i18n/index.ts';
import { tNav } from '../../i18n/nav.ts';
import { SITE_NAME } from '../../i18n/common.ts';
import { langPath, url } from '../../lib/url.ts';
import { tHz } from '../../i18n/horizontal.ts';
import BrandMark from './BrandMark.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  langSwitchToHome?: boolean;
}
const { lang, langSwitchToHome = false } = Astro.props;
const [first, ...rest] = SITE_NAME.split(' ');
const h = (k: Parameters<typeof tHz>[1]) => tHz(lang, k);
const palette = {
  index: langPath(lang, 'data/index.json'),
  search: langPath(lang, 'search/'),
  bundle: url('pagefind/pagefind.js'),
  base: url(),
  strings: {
    title: h('paletteOpen'),
    label: h('paletteLabel'),
    placeholder: h('palettePlaceholder'),
    hint: h('paletteHint'),
    entity: h('paletteEntity'),
    pattern: h('palettePattern'),
    glossary: h('paletteGlossary'),
    page: h('palettePage'),
    fulltext: h('paletteFulltext'),
    results: h('paletteResults'),
    none: h('paletteNone'),
    all: h('paletteAll'),
    close: h('paletteClose'),
    loading: h('loading'),
  },
};
---

<header class="topbar" data-nav="global">
  <a class="brand" href={langPath(lang)}>
    <BrandMark />
    <span class="brand-name"><span class="brand-main">{first}</span> <span class="brand-sub">{rest.join(' ')}</span></span>
  </a>
  <form class="topbar-search" role="search" action={langPath(lang, 'search/')} method="get">
    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="10.8" cy="10.8" r="6.6"></circle>
      <path d="M15.6 15.6 20.4 20.4"></path>
    </svg>
    <label class="visually-hidden" for="global-search">{tNav(lang, 'searchLabel')}</label>
    <input
      id="global-search"
      name="q"
      type="search"
      autocomplete="off"
      placeholder={tNav(lang, 'searchPlaceholder')}
      aria-describedby="global-search-hint"
      data-global-search
    />
    <kbd aria-hidden="true" data-shortcut-hint>Ctrl K</kbd>
    <span id="global-search-hint" class="visually-hidden">{tNav(lang, 'shortcutHint')}</span>
  </form>
  <div class="topbar-tools">
    <slot />
    <button
      type="button"
      class="icon-btn js-only"
      data-palette-open
      data-palette={JSON.stringify(palette)}
      aria-haspopup="dialog"
      aria-keyshortcuts="Control+K Meta+K"
      aria-label={h('paletteOpen')}
      title={h('paletteOpen')}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.6"></circle>
        <path d="M15.6 15.6 20.4 20.4"></path>
      </svg>
      {/* The shortcut, shown where the top bar has no search field to show it (600-1023 px) */}
      <kbd class="palette-kbd" aria-hidden="true" data-shortcut-hint>Ctrl K</kbd>
    </button>
    <LangSwitch lang={lang} toHome={langSwitchToHome} />
    <ThemeToggle lang={lang} />
  </div>
</header>

<style>
  /* Phones reach search from the bottom tab bar; keep the brand readable. From 1024 px the top bar has the search
     field, which shows the shortcut that opens the palette: a second magnifier would only repeat it. */
  @media (max-width: 599px), (min-width: 1024px) {
    [data-palette-open] {
      display: none;
    }
  }
  /* 740-1023 px (iPads in portrait): the shortcut on the button, where the bar has no search field to show it.
     Narrower bars and the largest reading size need that room for the site name. */
  .palette-kbd {
    display: none;
  }
  @media (min-width: 740px) and (max-width: 1023px) {
    :global(:root:not(.text-xl)) [data-palette-open] {
      grid-auto-flow: column;
      gap: var(--space-2);
      padding-inline: var(--space-3);
    }
    /* Fixed box: the script swaps "Ctrl K" for "⌘ K" on Apple devices after paint (no layout shift) */
    :global(:root:not(.text-xl)) .palette-kbd {
      display: block;
      box-sizing: border-box;
      width: 4.75em;
      text-align: center;
    }
  }
</style>
