---
/**
 * "Chapter" button in the top bar and its dialog: the chapter index where the sidebar does not show it (600-1023 px,
 * and from 1024 px with the sidebar collapsed). A native modal <dialog>: the platform keeps focus inside, Esc closes,
 * focus returns to the button (shell.ts opens it on the current card). Without JS neither shows.
 */
import type { Lang } from '../../i18n/index.ts';
import { tHz } from '../../i18n/horizontal.ts';
import type { SiteData } from '../../lib/content.ts';
import ModuleTree from './ModuleTree.astro';

interface Props {
  lang: Lang;
  data: SiteData;
  current: string;
}
const { lang, data, current } = Astro.props;
---

<button type="button" class="btn chapter-open js-only" aria-haspopup="dialog" data-chapter-open>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M9.5 6h10M9.5 12h10M9.5 18h10M4.5 6h.01M4.5 12h.01M4.5 18h.01"></path>
  </svg>
  {tHz(lang, 'chapterOpen')}
</button>
<dialog class="chapter-dialog" aria-labelledby="chapter-tree-title" data-chapter-dialog>
  <form method="dialog">
    <button class="icon-btn chapter-close" aria-label={tHz(lang, 'chapterClose')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path>
      </svg>
    </button>
  </form>
  <ModuleTree lang={lang} data={data} current={current} id="chapter-tree" />
</dialog>
