---
/**
 * Teaching image with caption, alt and credit line from the image YAML
 * (CONTENT_SCHEMA §5). <ap-image-viewer> (scripts/image-viewer.ts) adds
 * zoom/pan/pinch, pan buttons, keyboard zoom, label toggle, progressive
 * reveal, a full-screen dialog, a scale bar when `mpp` is known, and a
 * stain/section/magnification switch between the images of one `group`
 * (each keeps its own alt, labels, caption and credit).
 * Without JS: every image of the group, its labels and legend are visible.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fmt, type Lang } from '../../i18n/index.ts';
import { tHz } from '../../i18n/horizontal.ts';
import type { imageSchema } from '../../lib/schema.ts';
import type { z } from 'astro/zod';
import { readFile } from 'node:fs/promises';
import { PREVIEW_DRAFTS, images } from '../../lib/content.ts';
import { attributionFor, fileFor, groupMembers, licenseName, powerOf, stainCode } from '../../lib/image-meta.ts';
import '../../styles/viewer.css';

type Img = z.infer<typeof imageSchema>;
interface Props {
  lang: Lang;
  image: Img | undefined;
  /** Shown when the image YAML is missing. */
  id: string;
}
const { lang, image, id } = Astro.props;
const t = (k: Parameters<typeof tHz>[1]) => tHz(lang, k);
// `_`-prefixed files are fixtures: kept out of the bundle so they never reach a production build.
const files = import.meta.glob<{ default: ImageMetadata }>(['../../assets/images/**/*.{png,jpg,jpeg,webp,avif,gif,svg}', '!**/_*']);

async function load(img: Img) {
  const file = fileFor(img, lang);
  const loader = files[`../../assets/images/${file}`];
  const meta = loader ? (await loader()).default : undefined;
  // shortcut: fixture PNGs are inlined as data: URIs (PREVIEW_DRAFTS only), not optimized by astro:assets.
  const fixture =
    !meta && file.startsWith('_') && PREVIEW_DRAFTS ? await readFile(`${process.cwd()}/src/assets/images/${file}`) : undefined;
  if (!meta && !fixture) return undefined;
  const W = meta?.width ?? fixture!.readUInt32BE(16);
  const H = meta?.height ?? fixture!.readUInt32BE(20);
  const notes = [...img.annotations].sort((a, b) => a.revealOrder - b.revealOrder);
  // Original diagrams are SVG: served as the emitted file at its intrinsic size (no raster srcset).
  return { img, meta, fixture, W, H, notes, svg: file.endsWith('.svg') };
}
const members = image ? groupMembers(image.group ? await images() : [], image) : [];
const panels = (await Promise.all(members.map(load))).filter((p) => p !== undefined);
const active = panels.findIndex((p) => p.img.id === image?.id);

/** Label anchor point in %, from normalized shape coordinates. */
const anchor = (s: Img['annotations'][number]['shape']) => {
  const c = s.coords;
  if (s.type === 'circle') return { x: c[0]! * 100, y: c[1]! * 100 };
  if (s.type === 'rect') return { x: (c[0]! + c[2]! / 2) * 100, y: (c[1]! + c[3]! / 2) * 100 };
  const xs = c.filter((_, i) => i % 2 === 0);
  const ys = c.filter((_, i) => i % 2 === 1);
  return { x: (xs.reduce((a, b) => a + b, 0) / xs.length) * 100, y: (ys.reduce((a, b) => a + b, 0) / ys.length) * 100 };
};
const stainName = (img: Img) => {
  const code = stainCode(img.stain);
  if (!code) return undefined;
  return code.startsWith('IHC:') ? fmt(t('st_IHC'), { marker: code.slice(4) }) : t(`st_${code as Exclude<typeof code, `IHC:${string}`>}`);
};
/** Switch label: what differs between images of a group (stain · section · power · objective). */
const variantLabel = (img: Img, i: number) => {
  const power = powerOf(img.magnification);
  return (
    [stainName(img), img.section && t(`sec_${img.section}`), power && t(`pow_${power}`), img.objective].filter(Boolean).join(' · ') ||
    fmt(t('variantN'), { n: i + 1 })
  );
};
/** Stain and magnification keep the source's (English) wording; in the page language when that is just a name on our lists. */
const stainWords = (img: Img) => {
  const code = stainCode(img.stain);
  const plain = code && !code.startsWith('IHC:') && tHz('en', `st_${code as Exclude<typeof code, `IHC:${string}`>}`) === img.stain?.trim();
  return plain ? stainName(img) : undefined;
};
const powerWords = (img: Img) => {
  const power = /^(low|medium|intermediate|high) power$/i.test(img.magnification?.trim() ?? '') ? powerOf(img.magnification) : undefined;
  return power && t(`pow_${power}`);
};
const anyNotes = panels.some((p) => p.notes.length > 0);
/** Label placement that keeps it inside the image: anchored at its start, middle or end, top, middle or bottom. */
const place = (x: number, y: number) => ({ h: x < 30 ? 'start' : x > 70 ? 'end' : 'mid', v: y < 12 ? 'top' : y > 88 ? 'bottom' : 'mid' });
const helpId = `viewer-help-${id}`;
---

{
  image && active >= 0 ? (
    <figure class="viewer-figure" id={`fig-${id}`}>
      <ap-image-viewer>
        <div class="viewer-body">
          {panels.length > 1 && (
            <fieldset class="viewer-switch js-only">
              <legend class="small">{t('variants')}</legend>
              {panels.map((p, i) => (
                <label class="viewer-choice small">
                  <input type="radio" name={`viewer-${id}`} value={i} checked={i === active} />
                  <span>{variantLabel(p.img, i)}</span>
                </label>
              ))}
            </fieldset>
          )}
          <p id={helpId} class="visually-hidden">{t('viewerHelp')}</p>
          <div class="viewer-tools js-only" role="group" aria-label={t('viewerTools')}>
            <button type="button" class="btn btn-small" data-zoom="out" aria-label={t('zoomOut')}>−</button>
            <button type="button" class="btn btn-small" data-zoom="in" aria-label={t('zoomIn')}>+</button>
            <button type="button" class="btn btn-small" data-zoom="reset">{t('zoomReset')}</button>
            <span class="viewer-pan">
              <button type="button" class="btn btn-small" data-pan="left" aria-label={t('panLeft')} aria-disabled="true">←</button>
              <button type="button" class="btn btn-small" data-pan="up" aria-label={t('panUp')} aria-disabled="true">↑</button>
              <button type="button" class="btn btn-small" data-pan="down" aria-label={t('panDown')} aria-disabled="true">↓</button>
              <button type="button" class="btn btn-small" data-pan="right" aria-label={t('panRight')} aria-disabled="true">→</button>
            </span>
            {anyNotes && (
              <>
                <button type="button" class="btn btn-small" data-label-toggle aria-pressed="true">{t('labels')}</button>
                <button type="button" class="btn btn-small" data-reveal>{t('revealNext')}</button>
              </>
            )}
            <button type="button" class="btn btn-small" data-full data-open={t('fullOpen')} data-close={t('fullClose')}>
              {t('fullOpen')}
            </button>
          </div>
          {panels.map(({ img, meta, fixture, W, H, notes, svg }, i) => (
            <div class="viewer-panel" data-panel={i} data-total={notes.length} data-w={W} data-mpp={img.mpp} hidden={i !== active}>
              <div
                class="viewer-stage"
                tabindex="0"
                role="group"
                aria-label={t('zoomable')}
                aria-describedby={helpId}
                style={`--ar:${W}/${H}${svg ? `;max-width:${W}px` : ''}`}
              >
                <div class="viewer-canvas">
                  {meta && svg ? (
                    <img src={meta.src} alt={img.alt[lang]} width={W} height={H} loading="lazy" decoding="async" />
                  ) : meta ? (
                    <Image
                      src={meta}
                      alt={img.alt[lang]}
                      widths={[...new Set([480, 800, 1600, W].filter((w) => w <= W))]}
                      sizes="(min-width: 1024px) 46rem, 100vw"
                    />
                  ) : (
                    <img src={`data:image/png;base64,${fixture!.toString('base64')}`} alt={img.alt[lang]} width={W} height={H} />
                  )}
                  {notes.length > 0 && (
                    <svg class="viewer-shapes" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
                      {notes.map((n) => {
                        const c = n.shape.coords;
                        return n.shape.type === 'circle' ? (
                          <circle data-order={n.revealOrder} cx={c[0]! * W} cy={c[1]! * H} r={c[2]! * W} />
                        ) : n.shape.type === 'rect' ? (
                          <rect data-order={n.revealOrder} x={c[0]! * W} y={c[1]! * H} width={c[2]! * W} height={c[3]! * H} />
                        ) : (
                          <polygon data-order={n.revealOrder} points={c.map((v, j) => (j % 2 === 0 ? v * W : v * H)).join(' ')} />
                        );
                      })}
                    </svg>
                  )}
                  {notes.map((n, k) => {
                    const p = anchor(n.shape);
                    const at = place(p.x, p.y);
                    // data-n: the number shown instead of the text on phones; it matches the legend below.
                    return (
                      <span
                        class="viewer-label"
                        data-order={n.revealOrder}
                        data-n={k + 1}
                        data-h={at.h}
                        data-v={at.v}
                        style={`left:${p.x}%;top:${p.y}%`}
                        aria-hidden="true"
                      >
                        <span class="viewer-label-text">{n.label[lang]}</span>
                      </span>
                    );
                  })}
                </div>
                {img.mpp && <span class="viewer-scale js-only" data-scale />}
              </div>
              {notes.length > 0 && (
                <ol class="viewer-legend small" aria-label={t('labelList')}>
                  {notes.map((n, k) => (
                    <li data-order={n.revealOrder} value={k + 1}>
                      {n.label[lang]}
                    </li>
                  ))}
                </ol>
              )}
              {img.lookFor && (
                <p class="viewer-lookfor small">
                  <strong>{t('lookFor')}:</strong> {img.lookFor[lang]}
                </p>
              )}
            </div>
          ))}
          {/* Inside .viewer-body, so it moves into the dialog in full screen and stays exposed (WCAG 4.1.3). */}
          <p class="visually-hidden" role="status" data-viewer-status />
        </div>
        {/* A short fixed name: the image inside is named by its own alt, so the alt is read once. */}
        <dialog class="viewer-dialog" aria-label={t('fullDialog')} />
      </ap-image-viewer>
      <figcaption>
        {panels.map(({ img }, i) => (
          <div data-panel={i} hidden={i !== active}>
            <p>{img.caption[lang]}</p>
            {(img.stain || img.magnification || img.section || img.objective || img.orientation) && (
              <p class="small muted">
                {[
                  img.stain && [t('stain'), stainWords(img) ?? <span lang="en">{img.stain}</span>],
                  img.section && [t('section'), t(`sec_${img.section}`)],
                  img.magnification && [t('magnification'), powerWords(img) ?? <span lang="en">{img.magnification}</span>],
                  img.objective && [t('objective'), img.objective],
                  img.orientation && [t('orientation'), img.orientation[lang]],
                ]
                  .filter((part): part is [string, unknown] => !!part)
                  .map(([name, value], k) => (
                    <>
                      {k > 0 && ' · '}
                      {name}: {value}
                    </>
                  ))}
              </p>
            )}
            <p class="small muted credit">
              {t('credit')}: {attributionFor(img.attributionText, lang)} · <a href={img.licenseUrl}>{licenseName(img.license, lang)}</a>
              {img.modifications !== 'none' && ` · ${img.modifications[lang]}`}
            </p>
          </div>
        ))}
      </figcaption>
    </figure>
  ) : (
    <p class="empty-state small" id={`fig-${id}`}>{t('imageMissing')}</p>
  )
}
