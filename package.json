{
  "name": "atlante-patologia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlante di Patologia: free, open, bilingual pathology atlas and study system for medical students.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "guard": "node scripts/guard.mjs --tree",
    "contrast": "node scripts/contrast-check.mjs",
    "prepare": "simple-git-hooks",
    "no-verbatim": "node scripts/no-verbatim.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/guard.mjs --staged"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@preact/signals": "2.11.3",
    "astro": "7.3.8",
    "idb": "8.0.4",
    "preact": "10.29.8",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "pagefind": "1.5.2",
    "sharp": "0.35.5",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
